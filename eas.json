{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "environment": "production"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-testflight": {
      "extends": "development",
      "distribution": "store",
      "autoIncrement": true
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
