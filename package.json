{
  "name": "wysta",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && cp dist/index.html dist/404.html",
    "build:cf": "convex deploy --cmd 'bun run build:web'",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "deploy": "bun run build:web && wrangler deploy",
    "preview": "bun run build:web && wrangler dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/openai": "^3.0.60",
    "@convex-dev/auth": "^0.0.91",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "ai": "^6.0.175",
    "convex": "^1.30.0",
    "expo": "~55.0.31",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-unistyles": "^3.2.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.2.10",
    "convex-test": "^0.0.51",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  },
  "private": true,
  "overrides": {
    "@react-navigation/native-stack": "7.14.5"
  }
}
