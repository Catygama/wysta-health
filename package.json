{
  "name": "wysta",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && cp dist/index.html dist/404.html",
    "build:cf": "convex deploy --cmd 'bun run build:web'",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "deploy": "bun run build:web && wrangler deploy",
    "preview": "bun run build:web && wrangler dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:triage-report": "bun scripts/triage-report.ts",
    "test:ai-eval": "bun scripts/ai-eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/openai": "^3.0.60",
    "@convex-dev/auth": "^0.0.91",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "ai": "^6.0.175",
    "convex": "^1.30.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "^3.5.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.2.10",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.51",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  },
  "private": true
}
