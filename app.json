{
  "expo": {
    "name": "Wysta",
    "slug": "wysta-app",
    "owner": "wysta-health",
    "version": "1.0.0",
    "scheme": "wysta",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "health.wysta.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "android": {
      "package": "health.wysta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#50000D"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Wysta usa a galeria para anexar imagens (ex.: exames, receitas) às tuas conversas com profissionais de saúde.",
          "cameraPermission": "A Wysta usa a câmara para anexar fotografias às tuas conversas com profissionais de saúde.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#50000D"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EFDCD6",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#50000D"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "852c6753-ceab-4036-b5a9-a75b89a182fd"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/852c6753-ceab-4036-b5a9-a75b89a182fd"
    }
  }
}
